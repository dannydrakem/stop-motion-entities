{
  "schemaVersion": 1,
  "id": "stepped_player_animations",
  "version": "${version}",
  "name": "Stop Motion Entities",
  "description": "Give Minecraft animations a stylized, handcrafted stop-motion look. Choose the animation frame rate for players, mobs, and vehicles while keeping their movement smooth — perfect for cinematic videos, machinima, and creative content.",
  "icon": "assets/stepped_player_animations/icon.png",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.steppedplayeranimations.SteppedPlayerAnimationsClient"
    ],
    "modmenu": [
      "dev.steppedplayeranimations.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "stepped_player_animations.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.116.5"
  },
  "suggests": {
    "entity_model_features": ">=3.3.9",
    "entity_texture_features": ">=7.2.4",
    "emotecraft": ">=2.4.12",
    "playeranimator": ">=2.0.4+1.21.1",
    "modmenu": ">=11.0.0",
    "figura": ">=0.1.6"
  }
}
